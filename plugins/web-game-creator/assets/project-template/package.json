{
  "name": "poki-game-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "build:poki": "npm run check && vite build --mode poki",
    "build:yoola": "npm run check && vite build --mode yoola",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/core.test.ts",
    "test:browser": "npm run build:poki && node tests/browser.mjs",
    "test:yoola": "npm run build:yoola && node tests/yoola-browser.mjs"
  },
  "devDependencies": {
    "@types/webxr": "0.5.24",
    "playwright": "1.64.0",
    "typescript": "~5.9.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "playcanvas": "2.23.3"
  }
}
